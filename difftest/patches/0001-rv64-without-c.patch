diff --git a/src/isa/riscv64/local-include/rtl.h b/src/isa/riscv64/local-include/rtl.h
index e7f66a04..d4e98121 100644
--- a/src/isa/riscv64/local-include/rtl.h
+++ b/src/isa/riscv64/local-include/rtl.h
@@ -18,9 +18,30 @@
 #define __RISCV64_RTL_H__
 
 #include <rtl/rtl.h>
+#include <cpu/cpu.h>
 #include "reg.h"
 #include "csr.h"
 #include "trigger.h"
+#include "intr.h"
+
+static inline void riscv64_check_cfi_target(Decode *s, vaddr_t target) {
+#ifdef CONFIG_RV_NO_C
+  if (target & 3) {
+    save_globals(s);
+    cpu.trapInfo.tval = target;
+    longjmp_exception(EX_IAM);
+  }
+#endif
+}
+
+static inline void riscv64_check_branch_target(Decode *s, uint32_t relop,
+    const rtlreg_t *src1, const rtlreg_t *src2, vaddr_t target) {
+#ifdef CONFIG_RV_NO_C
+  if (interpret_relop(relop, *src1, *src2)) {
+    riscv64_check_cfi_target(s, target);
+  }
+#endif
+}
 
 #define FBOX_MASK 0xFFFFFFFF00000000ull
 #define HFBOX_MASK 0xFFFFFFFFFFFF0000ull

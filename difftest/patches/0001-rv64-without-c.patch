@@ -1,5 +1,16 @@
 menu "ISA-dependent Options for riscv64"
 
+config RV_NO_C
+  bool "Disable compressed instructions (IALIGN=32)"
+  depends on !CUSTOM_TENSOR && !RV_ZCB && !RV_ZCMOP
+  select MISA_UNCHANGEABLE
+  default n
+  help
+    Use fixed 32-bit instruction fetch and four-byte instruction alignment.
+    Compressed encodings raise illegal-instruction exceptions. Taken branches
